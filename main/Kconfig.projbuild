menu "Ink ESP"

config INK_RUN_EINK_BRINGUP_ON_BOOT
    bool "Run e-ink bring-up drawing on boot"
    default n
    help
        Enable the panel validation draw sequence during boot. Keep this off
        for product-style startup so the display is not refreshed automatically.

choice INK_PANEL_MODEL
    prompt "E-ink panel driver model"
    default INK_PANEL_MODEL_213_UC8151D_Z19C

    config INK_PANEL_MODEL_213_UC8151D_Z19C
        bool "2.13-inch UC8151D Z19c (GxEPD2_213_Z19c)"
        help
            104x212 tri-color panel aligned to the GxEPD2_213_Z19c reference path.
endchoice

config INK_PANEL_POWER_ON_TIME_MS
    int "E-ink power-on wait (ms)"
    range 20 500
    default 100
    help
        Fixed wait after panel power-on when BUSY is not connected.

config INK_PANEL_POWER_OFF_TIME_MS
    int "E-ink power-off wait (ms)"
    range 10 500
    default 50
    help
        Fixed wait after panel power-off when BUSY is not connected.

config INK_PANEL_CLEAR_REFRESH_TIME_MS
    int "E-ink clear refresh wait (ms)"
    range 4000 20000
    default 12000
    help
        Fixed wait for the white-clear stage. The official Z19c reference uses
        about 17000ms; most 2.13-inch tri-color panels are closer to 12000-15000ms.

config INK_PANEL_FULL_REFRESH_TIME_MS
    int "E-ink full refresh wait (ms)"
    range 8000 20000
    default 15000
    help
        Fixed wait for the full draw stage. Official Z19c reference uses about
        17000ms; this default is reduced toward the common 2.13-inch tri-color baseline.

config INK_PANEL_CLEAR_BEFORE_DRAW
    bool "Run clear-white stage before drawing"
    default n
    help
        Enable the extra bring-up validation step that clears the panel to white
        before drawing the test pattern. Keep this off for normal startup flows.

choice INK_SCENE_CJK_FONT
    prompt "CJK font for e-ink scenes"
    default INK_SCENE_CJK_FONT_PUHUI_14
    help
        Select the CJK font used by firmware-rendered scenes such as memos.
        PuHui 14 is copied from the xiaozhi font component and is a compact
        1bpp font suitable for the 2.13-inch black/white e-paper path.

    config INK_SCENE_CJK_FONT_PUHUI_14
        bool "Alibaba PuHui 14 1bpp"
        help
            Use xiaozhi's font_puhui_14_1 glyph set. This covers common Chinese
            memo text much better than LVGL's small SourceHanSansSC CJK subset.

    config INK_SCENE_CJK_FONT_SOURCE_HAN_14
        bool "LVGL SourceHanSansSC 14 CJK subset"
        depends on LV_FONT_SOURCE_HAN_SANS_SC_14_CJK
        help
            Use LVGL's built-in SourceHanSansSC 14 CJK subset. This is smaller
            in project source files but misses some common simplified Chinese
            characters such as fan/sleep/wake in memo text.
endchoice

config AUDIO_RECORD_BUTTON_GPIO
    int "Audio record trigger button GPIO"
    range 0 21
    default 9
    help
        Pressing this button starts a short recording test.

config AUDIO_RECORD_DURATION_MS
    int "Audio recording duration (ms)"
    range 1000 10000
    default 5000
    help
        Maximum duration for each test recording.

config AUDIO_RECORD_SAMPLE_RATE
    int "Audio recording sample rate (Hz)"
    range 8000 48000
    default 16000
    help
        Sample rate used for I2S capture and WAV export.

config AUDIO_RECORD_I2S_RAW_DIAG
    bool "Log raw I2S capture diagnostics"
    default y
    help
        Print a short raw I2S frame dump and alternate sample interpretations
        during recording. This is useful while validating ES8311 slot width,
        bit alignment, and ADC output on a new board.

config AUDIO_ES8311_ANALOG_MIC_FIXUP
    bool "Apply board-specific ES8311 analog mic register fixup"
    default y
    help
        Explicitly confirm ES8311 analog Mic1P-Mic1N capture registers after
        the component's generic microphone setup. Register 0x14 uses the ES8311
        datasheet encoding, where 0x1A means Mic1P-Mic1N with max 30dB analog
        PGA. Do not map the es8311_mic_gain_t enum directly into register 0x14.

config AUDIO_PORTAL_AP_SSID
    string "Audio portal AP SSID"
    default "INK-ESP-AUDIO"
    help
        SoftAP name used for the local audio export portal.

config AUDIO_PORTAL_WIFI_START_DELAY_MS
    int "Audio portal Wi-Fi start delay (ms)"
    range 0 10000
    default 2000
    help
        Delay before starting SoftAP to reduce startup current overlap.

config AUDIO_PORTAL_WIFI_MAX_TX_POWER_QDBM
    int "Audio portal Wi-Fi max TX power (0.25 dBm units)"
    range 8 84
    default 32
    help
        Wi-Fi max TX power in quarter-dBm units. 32 means 8 dBm, which is
        enough for short-range phone connection while reducing power peaks.

config AUDIO_PORTAL_BUTTON_LONG_PRESS_MS
    int "Audio portal BOOT long-press threshold (ms)"
    range 1000 10000
    default 3000
    help
        Hold BOOT for this long to start the export hotspot.

config AUDIO_PORTAL_STA_AUTOCONNECT_DELAY_MS
    int "Audio portal saved Wi-Fi autoconnect delay (ms)"
    range 0 60000
    default 15000
    help
        Delay after the local SoftAP portal is ready before reconnecting to
        saved STA credentials. This gives phones time to discover and open the
        local portal before APSTA channel follows the upstream router.

config AUDIO_PORTAL_DIAGNOSTIC_WIFI_ONLY
    bool "Start minimal Wi-Fi only for long-press diagnostics"
    default n
    help
        When enabled, long-press BOOT starts only the minimal SoftAP path
        without HTTP portal services. Use this to isolate Wi-Fi startup issues.

endmenu
